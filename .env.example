# Copy to .env and fill in. Never commit the real file.

# Week 3 - LLM exception narratives
ANTHROPIC_API_KEY=
# Only needed when the key above is an organisation-level key rather than a
# workspace-scoped one (the API then requires the workspace on every request).
ANTHROPIC_WORKSPACE_ID=

# Week 4 - QuickBooks Online (sandbox credentials only)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
QBO_ENVIRONMENT=sandbox
# Must match a redirect URI registered on the Intuit app (Keys & credentials).
QBO_REDIRECT_URI=http://localhost:8765/callback
# Optional: the company's own IANA time zone (e.g. America/Los_Angeles). QuickBooks' API
# timestamps are converted to it; report times carry no zone and are taken to be in it
# already, so any other zone would put entries on two clocks. Unset keeps the clock time
# QuickBooks reports, which is already the company's.
QBO_TIMEZONE=
# Tokens never go in this file: the QuickBooks connector keeps them, mode 600, in
# ~/.config/ledgerlens/qbo-<environment>-<realm_id>.json ($XDG_CONFIG_HOME/ledgerlens when
# that is set; $LEDGERLENS_TOKEN_DIR overrides both), outside any git checkout.

# Week 3 - MCP server (defaults shown; absolute paths when launched by Claude Desktop)
LEDGERLENS_LEDGER=data/ledger.csv
LEDGERLENS_REVIEW_DB=data/review.sqlite
