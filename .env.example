# Copy to .env and fill in. Never commit the real file.

# Week 3 - LLM exception narratives
ANTHROPIC_API_KEY=
# Only needed when the key above is an organisation-level key rather than a
# workspace-scoped one (the API then requires the workspace on every request).
ANTHROPIC_WORKSPACE_ID=

# Week 4 - QuickBooks Online (sandbox credentials only)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
QBO_ENVIRONMENT=sandbox

# Week 3 - MCP server (defaults shown; absolute paths when launched by Claude Desktop)
LEDGERLENS_LEDGER=data/ledger.csv
LEDGERLENS_REVIEW_DB=data/review.sqlite
