# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Generated data & outputs — never commit ledgers
data/*.csv
data/*.parquet
data/*.sqlite
data/*.xlsx
out/
*.xlsx
# Narrative eval run rows are deliberately committed under evals/narratives/runs/
# (the default synthetic ledger only: the eval refuses other ledgers anywhere under
# evals/ or docs/, and a test rebuilds every stored prompt from that ledger) so a
# reader can re-grade a run.

# Secrets — QuickBooks tokens, API keys
.env
.env.*
!.env.example
secrets/

# Local tooling
.claude/

# OS
.DS_Store
